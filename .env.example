# Copy to .env and fill in. Never commit .env.

# Database (local docker compose default shown)
DATABASE_URL=postgresql+psycopg://stj:stj@localhost:5432/stj

# Anthropic API (create at console.anthropic.com)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-5-5
COACH_MODEL=claude-sonnet-5-5

# Pipeline
COLLECTOR_USER_AGENT=SaudiTechJobsBot/0.1 (+https://github.com/Abdulaziz20245/Saudi-Tech-Jobs)
COLLECTOR_RATE_LIMIT_PER_SEC=1
EXTRACTION_BATCH_SIZE=50
EXTRACTION_MAX_DAILY_COST_USD=2

# API
CORS_ORIGINS=http://localhost:5173
COACH_RATE_LIMIT_PER_HOUR=5

# Frontend (Vite reads VITE_* vars)
VITE_API_URL=http://localhost:8000
